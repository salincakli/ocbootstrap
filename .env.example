# up.sahin.tech temps API (or your own Temps instance)
TEMPS_API_BASE_URL=https://your-temps-instance.example.com
TEMPS_API_KEY=tk_your_temps_api_key

# CodeNomad server login (choose your own strong password)
CODENOMAD_SERVER_PASSWORD=change-me-to-something-long-and-random

# Fish Audio (https://fish.audio -> API keys)
FISHAUDIO_API=https://api.fish.audio/v1/tts
FISHAUDIO_API_KEY=sk-fish-your_key_here

# CodeNomad TTS via local fish-audio bridge (OpenAI-compatible env vars)
TTS_BRIDGE_PORT=8787
OPENAI_BASE_URL=http://127.0.0.1:8787/v1
OPENAI_API_KEY=sk-fish-your_key_here
